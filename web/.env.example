# Copy this file to .env.local and fill in what you have.
# Everything is optional: without keys, KinGuard runs on its built-in rules
# and logs emails on the dashboard instead of sending them.

# Gemini (free key from Google AI Studio). Check AI Studio for the current model name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the main model is overloaded.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Resend email. With the test sender below, Resend only delivers to the
# email address on your own Resend account, so use that as FAMILY_EMAIL.
RESEND_API_KEY=
RESEND_FROM=KinGuard <onboarding@resend.dev>
FAMILY_EMAIL=

# Optional: Twilio text message + phone call to the family for the most urgent alerts
# (a scam warning followed by a payment). A Twilio trial account can only text and call
# phone numbers you have verified in Twilio. Use +1 format, for example +18145550123.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAMILY_PHONE=

# Starting values only. Change names, email, phone and alert types any time in the dashboard's Settings.
ELDER_NAME=Frank
FAMILY_NAME=Sarah

# Optional: ElevenLabs voice for "Read this to me". Without it, the browser's built-in voice is used.
# Check the ElevenLabs docs for current voice IDs and model names.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
